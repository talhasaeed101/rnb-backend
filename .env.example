MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/rnb_collections?appName=Cluster0
PORT=5000
NODE_ENV=development
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
CLIENT_URL=http://localhost:3000,https://rnb-collection.vercel.app
ADMIN_URL=http://localhost:5173,https://rnb-admin.vercel.app
ADMIN_NAME=RNB Admin
ADMIN_EMAIL=admin@rnbcollections.com
ADMIN_PASSWORD="CHANGE_THIS_ADMIN_PASSWORD"

# Brevo SMTP (customer auth emails) — set in your real .env, do not commit secrets
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_THIS_SMTP_USER
SMTP_PASS=CHANGE_THIS_SMTP_PASS
SMTP_FROM=rnbcollections.com@gmail.com
EMAIL_FROM_NAME=RNB Collections

# Optional Google customer sign-in
# GOOGLE_CLIENT_ID=

R2_ACCOUNT_ID=CHANGE_THIS
R2_BUCKET_NAME=rnb-collections
R2_ACCESS_KEY_ID=CHANGE_THIS
R2_SECRET_ACCESS_KEY=CHANGE_THIS
R2_PUBLIC_URL=https://example.r2.dev
